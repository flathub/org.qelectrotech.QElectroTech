        },
        {
          "type": "archive",
          "url": "https://github.com/zeux/pugixml/archive/5a1892b321a38997e3e359069aea3fa35d49a5c6.tar.gz",
          "sha256": "1c0a19e5928c153e26623b867990bb43fb7826e69bfba8f7b33dd326174d7df5",
          "dest": "pugixml"
        },
        {
